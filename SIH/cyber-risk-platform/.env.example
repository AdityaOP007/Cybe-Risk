# ========================================
# Cyber Risk Platform — Environment Config
# ========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- Application ---
APP_NAME=Cyber Risk Platform
APP_ENV=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cyber_risk

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Security (REPLACE in production) ---
SECRET_KEY=replace_me_with_a_strong_random_secret
JWT_ALGORITHM=HS256
